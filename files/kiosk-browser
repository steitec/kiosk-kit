#!/bin/bash
# Kiosk browser launcher, started by GNOME autostart for every user -- it exits
# unless it runs as KIOSK_USER. Waits for the page's server, then keeps Chromium
# running full screen and restarts it when it crashes or gets closed.
set -u
# shellcheck source-path=SCRIPTDIR/.. source=kiosk.conf
. /etc/kiosk-kit/kiosk.conf
[[ "$(id -un)" == "$KIOSK_USER" ]] || exit 0

profile="$HOME/.config/kiosk-kit"
cache="$HOME/.cache/kiosk-kit"

# Wait for host:port of KIOSK_URL, otherwise Chromium shows an error page after boot.
if [[ "$KIOSK_URL" =~ ^(https?)://([^/:]+)(:([0-9]+))? ]]; then
  host="${BASH_REMATCH[2]}"
  port="${BASH_REMATCH[4]:-$([[ ${BASH_REMATCH[1]} == https ]] && echo 443 || echo 80)}"
  for ((waited = 0; waited < WAIT_TIMEOUT; waited += 2)); do
    (exec 3<>"/dev/tcp/$host/$port") 2>/dev/null && break
    sleep 2
  done
fi

# Chromium takes its UI language from the environment on Linux.
export LANGUAGE="$KIOSK_LANG"

while true; do
  # No "Restore pages?" bubble after a crash or power loss.
  sed -i 's/"exited_cleanly":false/"exited_cleanly":true/; s/"exit_type":"[^"]*"/"exit_type":"Normal"/' \
    "$profile/Default/Preferences" 2>/dev/null
  [[ "$CLEAR_CACHE" == yes ]] && rm -rf "$cache"
  chromium \
    --user-data-dir="$profile" \
    --disk-cache-dir="$cache" \
    --kiosk "$KIOSK_URL" \
    --no-first-run \
    --noerrdialogs \
    --disable-infobars \
    --disable-session-crashed-bubble \
    --disable-features=Translate,TranslateUI \
    --password-store=basic \
    --disable-pinch \
    --overscroll-history-navigation=0 \
    --check-for-update-interval=31536000
  sleep 5
done
